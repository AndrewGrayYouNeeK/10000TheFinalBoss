{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roll10000-online",
  "main": "server/index.js",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "alias": {
    "@": "./src"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    }
  ],
  "vars": { "ALLOWED_ORIGINS": "https://roll10000.com,https://www.roll10000.com" },
  "routes": [
    { "pattern": "online.roll10000.com", "custom_domain": true },
    { "pattern": "online.roll10000.com/*", "zone_name": "roll10000.com" }
  ]
}
