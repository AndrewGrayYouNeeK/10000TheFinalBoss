# YouNeeK 10,000 — environment variables
# Copy to .env.local for local overrides (optional; app runs with no env vars)

# Vite dev server port (optional)
# PORT=5173

# Future: online multiplayer server URL (not used in standalone build)
# VITE_API_URL=http://localhost:3001

# Unlock every shop + custom dice for local development (also on in `npm run dev`)
# VITE_UNLOCK_ALL_DICE=true

# --- Private labs (forever — not launch cutover) ---
# Comma-separated emails that may open /sprite-lab, /felt-lab, /ice-lab, etc. on production.
# Local `npm run dev` always allows labs without sign-in.
# VITE_LAB_ADMIN_EMAILS=you@email.com

# --- Marketing / launch cutover ---
# Pre-launch (default): web play stays on roll10000.com
# VITE_WEB_PLAY_ENABLED=true
# At App Store launch: set false, rebuild, and `npm run deploy:web`
# VITE_WEB_PLAY_ENABLED=false

# App Store link (landing CTAs)
# VITE_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID

# --- Supabase (auth, entitlements, community) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Edge Function secrets (set via `supabase secrets set`, never VITE_):
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SITE_URL=https://www.roll10000.com

# fal.ai — do NOT store here. Put FAL_KEY in Cursor user settings instead:
#   Cursor Settings → search "terminal.integrated.env.osx" → add FAL_KEY
# Also export in ~/.zshenv so Cursor Agent shell commands can read it.
# NEVER prefix with VITE_ — would expose the key to the browser bundle.
