# YouNeeK 10,000 — environment variables
# Copy to .env.local for local overrides (optional; app runs with no env vars)

# Vite dev server port (optional)
# PORT=5173

# Future: online multiplayer server URL (not used in standalone build)
# VITE_API_URL=http://localhost:3001

# Unlock every shop + custom dice for local development (also on in `npm run dev`)
# VITE_UNLOCK_ALL_DICE=true

# Password for creator labs / customize tools on production builds (baked in at build time).
# In `npm run dev`, labs unlock automatically — no password needed.
# Production: set this, rebuild, and deploy. Unlock by visiting /sprite-lab and entering it.
# VITE_LAB_GATE_PASSWORD=your-secret

# fal.ai — do NOT store here. Put FAL_KEY in Cursor user settings instead:
#   Cursor Settings → search "terminal.integrated.env.osx" → add FAL_KEY
# Also export in ~/.zshenv so Cursor Agent shell commands can read it.
# NEVER prefix with VITE_ — would expose the key to the browser bundle.
